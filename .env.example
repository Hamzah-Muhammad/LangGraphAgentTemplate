# ---- Model: any OpenAI-compatible host (Groq, NVIDIA NIM, OpenRouter, local vLLM/Ollama) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL_NAME=llama-3.3-70b-versatile

# ---- Fallback model (optional). Used when the primary errors after retries. ----
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL_NAME=

# ---- LangSmith tracing (optional; blank = off) ----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=LangGraphAgentTemplate

# ---- Memory ----
MEMORY_DB_PATH=memory.db
DEFAULT_USER_ID=hamzah

# ---- Cost accounting (optional; USD per 1M tokens, blank = tokens only) ----
PRICE_IN_PER_M=
PRICE_OUT_PER_M=
