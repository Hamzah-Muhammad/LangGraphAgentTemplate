# ==========================================================================================
# CHOOSE YOUR MODEL
# Set MODEL_PROVIDER to one of the two options, then fill in that option's block.
# To switch later, change this ONE line.  For one run only: python run.py --provider ...
#   openai       an API key on any OpenAI-compatible host            -> fill in OPTION A
#   claude-code  your Claude Pro/Max login, no API key               -> fill in OPTION B
# ==========================================================================================
MODEL_PROVIDER=openai

# ---- OPTION A  (MODEL_PROVIDER=openai): an API-style LLM ----
# Any OpenAI-compatible host: Groq, NVIDIA NIM, OpenRouter, Together, OpenAI, local vLLM/Ollama.
# Ignored while MODEL_PROVIDER=claude-code.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL_NAME=llama-3.3-70b-versatile

# ---- OPTION B  (MODEL_PROVIDER=claude-code): Claude through your Claude login ----
# One-time setup:  pip install -e ".[claude]"   and sign in to Claude Code (claude, then /login).
# Model: haiku, sonnet, opus or a full model id. Usage draws from your Claude plan limits.
# Ignored while MODEL_PROVIDER=openai.
CLAUDE_MODEL=sonnet

# ---- Fallback model (optional). Used when the primary errors after retries. ----
# Same two options. For claude-code, only FALLBACK_MODEL_NAME is needed (e.g. haiku).
FALLBACK_PROVIDER=openai
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL_NAME=

# ---- LangSmith tracing (optional; blank = off) ----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=LangGraphAgentTemplate

# ---- Memory ----
MEMORY_DB_PATH=memory.db
DEFAULT_USER_ID=default-user

# ---- Cost accounting (optional; USD per 1M tokens, blank = tokens only) ----
PRICE_IN_PER_M=
PRICE_OUT_PER_M=

# ---- Grader model for evaluator mode (optional; blank = reuse primary) ----
# Same two options. For claude-code, only GRADER_MODEL_NAME is needed (e.g. sonnet).
GRADER_PROVIDER=openai
GRADER_API_KEY=
GRADER_BASE_URL=
GRADER_MODEL_NAME=

# ---- Context window and harness ----
CONTEXT_WINDOW_TOKENS=32000
AGENT_TODOS=false
OFFLOAD_CHARS=20000
OFFLOAD_DIR=.agent_files

# ---- Workflow caps ----
MAX_WORKERS=6
MAX_CONCURRENCY=3
MAX_PLAN_ROUNDS=2
MAX_EVAL_ROUNDS=3
MAX_SUPERVISOR_HOPS=6

# ---- Timeouts and memory ----
REQUEST_TIMEOUT_S=120
TOOL_TIMEOUT_S=60
MEMORY_INJECT=true
MEMORY_INJECT_LIMIT=10
MCP_STRICT=false
