#!/bin/sh
# Blocks a commit that contains an API key, a token or a .env file.
# Enable once per clone:   python scripts/setup.py   (or: git config core.hooksPath .githooks)
if [ -x .venv/Scripts/python.exe ]; then PY=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then PY=.venv/bin/python
else PY=python
fi
exec "$PY" scripts/check_secrets.py --staged
